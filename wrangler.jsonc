{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-22",
  // global_fetch_strictly_public lets the OAuth provider fetch client metadata documents (CIMD)
  // safely: fetch() can only reach the public internet, never this zone or its origin.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Served as askscottpierce.com/tasks. Routes run ahead of whatever else serves the zone.
  // The two /.well-known routes are OAuth discovery for the MCP endpoint. RFC 8414 and
  // RFC 9728 put them at the domain root, so this app is the OAuth server for the whole
  // domain. Nothing else on askscottpierce.com uses them.
  "routes": [
    { "pattern": "askscottpierce.com/tasks", "zone_name": "askscottpierce.com" },
    { "pattern": "askscottpierce.com/tasks/*", "zone_name": "askscottpierce.com" },
    { "pattern": "askscottpierce.com/.well-known/oauth-authorization-server", "zone_name": "askscottpierce.com" },
    { "pattern": "askscottpierce.com/.well-known/oauth-protected-resource/tasks/*", "zone_name": "askscottpierce.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    // The Worker answers every /tasks address, so one that isn't a page can be a real 404
    // (src/server.ts, src/routes.ts). Only the hashed build output and the Needle model files
    // skip it. Nothing falls back to index.html on its own: a missing file is a 404.
    "not_found_handling": "none",
    "run_worker_first": [
      "/tasks", "/tasks/*", "!/tasks/assets/*", "!/tasks/needle/*",
      "/.well-known/oauth-authorization-server", "/.well-known/oauth-protected-resource/*"
    ]
  },
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-agent-auth",
      "database_id": "616a0109-b37d-4298-98f9-cbbe8387d9c0",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  // OAuth clients, grants, and tokens for outside agents (@cloudflare/workers-oauth-provider).
  // Created by the first deploy's auto-provisioning ("todo-agent-oauth-kv").
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "97d2042e9ac84425ac8b7ca68945aef5" }],
  // Card attachments, stored as <user id>/<attachment id>. Created by the first deploy
  // that included them, then pinned here.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "todo-agent-attachments" }],
  "durable_objects": {
    "bindings": [
      { "name": "TodoAgent", "class_name": "TodoAgent" },
      // Event sockets for agent sessions (src/events.ts), one per user, kept apart from the board's.
      { "name": "TaskEvents", "class_name": "TaskEvents" },
      // Claude Code sessions reporting in, and card claims (src/presence.ts), one per user.
      { "name": "Presence", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TodoAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["TaskEvents"] },
    { "tag": "v3", "new_sqlite_classes": ["Presence"] }
  ],
  "vars": {
    // Cheap Workers AI model with tool calling ($0.06 in / $0.40 out per M tokens).
    // Swap to "@cf/qwen/qwen3-30b-a3b-fp8" or "@cf/openai/gpt-oss-20b" if you prefer.
    "CHAT_MODEL": "@cf/zai-org/glm-4.7-flash",
    // Must be an address on a domain onboarded to Cloudflare Email Sending.
    "EMAIL_FROM": "hey@askscottpierce.com",
    // Comma-separated emails or "@domain.com" rules. Empty lets anyone sign up, which
    // is the public setting: Turnstile guards the email form, and FREE_DAILY_CHATS caps
    // each account's assistant use.
    "ALLOWED_EMAILS": "",
    // Turnstile on the email sign-in form. Empty sitekey turns it off. The secret is
    // TURNSTILE_SECRET (wrangler secret put). Hostnames are the ones siteverify may
    // report for a real token; never add localhost here.
    "TURNSTILE_SITEKEY": "0x4AAAAAACmZxOxCRxlu8sDn",
    "TURNSTILE_HOSTNAMES": "askscottpierce.com",
    // Assistant messages per user per day. The board and MCP are never capped.
    "FREE_DAILY_CHATS": "30",
    "PRO_DAILY_CHATS": "150",
    // Attachment storage per user, and the largest single file.
    "ATTACHMENT_QUOTA_MB": "250",
    "ATTACHMENT_MAX_MB": "25",
    // Team boards (src/members.ts). The most people on one board, pending invites included;
    // the most invite emails one owner can send in a UTC day, resends included, so an account
    // can't be used to send spam; and how often a board rechecks its connected members against
    // D1 as a backstop to the signal it gets when membership or the owner's plan changes.
    "MAX_BOARD_MEMBERS": "10",
    "MAX_DAILY_INVITE_EMAILS": "20",
    "MEMBER_RECHECK_SECONDS": "30",
    // Workers AI embedding model for semantic search. Changing it re-embeds every card.
    "EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
    // Stripe price for the Pro subscription (price_…). Billing stays off until this and
    // the STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET secrets are set.
    "STRIPE_PRICE_ID": "",
    // Google sign-in (Google Cloud project ask-scott-pierce, client "Tasks web"). The
    // client ID is public; GOOGLE_CLIENT_SECRET is a secret.
    "GOOGLE_CLIENT_ID": "400799187975-uljuberbt7uciidou2qp0vqr7fotbmat.apps.googleusercontent.com"
  }
}
