{
  "name": "todo-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit",
    "check:markdown": "node scripts/check-markdown.mjs",
    "db:migrate:local": "wrangler d1 migrations apply todo-agent-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply todo-agent-auth --remote",
    "dev:local": "LOCAL_ONLY=1 vite dev",
    "bench": "node bench/run.mjs",
    "bench:needle": "node bench/needle.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.112",
    "@cloudflare/ai-chat": "^0.12.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "ai": "^7.0.109",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  }
}
